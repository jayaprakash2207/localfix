DATABASE_URL=postgresql+psycopg://localfix:localfix@localhost:5432/localfix_auth
ENVIRONMENT=development
SESSION_DURATION_MINUTES=60
PASSWORD_RESET_LINK_DURATION_MINUTES=30
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_THRESHOLD=5
RATE_LIMIT_WINDOW_MINUTES=15

# Feature 002: LocalFix Frontend and Web Authentication
# COOKIE_SECURE has no default - it is required. true in any HTTPS/production deployment;
# false only for plain local HTTP development. A production environment with this set to
# false will refuse to start.
COOKIE_SECURE=false

# Comma-separated list of reverse-proxy addresses this deployment trusts to supply a real
# client address via X-Forwarded-For. Leave empty (the default) unless this app sits behind
# a known reverse proxy - an empty list means forwarded headers are never honored.
TRUSTED_PROXY_IPS=

# Real password-reset email delivery (no defaults - required for the password-reset flow to
# actually deliver mail). SMTP_USERNAME/SMTP_PASSWORD may be left empty for a relay that
# requires no authentication (e.g. a local dev SMTP debugging sink); AUTH is only attempted
# when both are non-empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
